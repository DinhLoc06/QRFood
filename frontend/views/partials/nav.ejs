
<header class="site-header">
    <div class="header-inner">
        <a href="<%- e(appUrl('')) %>" class="brand">
            <%- include('logo', { logoClass: 'vp-logo-on-mark' }) %>
            <span class="brand-text">Velvet Plate<small>Bếp Việt mỗi ngày</small></span>
        </a>

        <button type="button" class="nav-toggle" id="navToggle" aria-expanded="false" aria-controls="mainNav"
            aria-label="Mở menu">
            <span class="nav-toggle-bar"></span>
            <span class="nav-toggle-bar"></span>
            <span class="nav-toggle-bar"></span>
        </button>
        <nav class="main-nav" id="mainNav">
            <% if (role === 'guest') { %>
                <a class="nav-link <%= current === '' ? 'is-active' : '' %>" href="<%- e(appUrl('')) %>">Trang chủ</a>
                <a class="nav-link <%= current === 'menu' ? 'is-active' : '' %>" href="<%- e(appUrl('menu')) %>">Thực đơn</a>
            <% } else if (role === 'customer') { %>
                <a class="nav-link <%= current === '' ? 'is-active' : '' %>" href="<%- e(appUrl('')) %>">Trang chủ</a>
                <a class="nav-link <%= current === 'menu' ? 'is-active' : '' %>" href="<%- e(appUrl('menu')) %>">Thực đơn</a>
                <a class="nav-link <%= current === 'orders' ? 'is-active' : '' %>" href="<%- e(appUrl('orders')) %>">Đơn hàng của tôi</a>
            <% } else if (role === 'admin') { %>
                <a class="nav-link <%= current === 'dashboard' ? 'is-active' : '' %>"
                    href="<%- e(appUrl('dashboard')) %>">Tổng quan</a>
                <a class="nav-link <%= current === 'pos' ? 'is-active' : '' %>" href="<%- e(appUrl('pos')) %>">POS</a>
                <a class="nav-link <%= current === 'kitchen' ? 'is-active' : '' %>"
                    href="<%- e(appUrl('kitchen')) %>">Nhà bếp</a>
                <a class="nav-link <%= current === 'orders' ? 'is-active' : '' %>"
                    href="<%- e(appUrl('orders')) %>">Đơn hàng</a>
                <a class="nav-link <%= current === 'manage-menu' ? 'is-active' : '' %>"
                    href="<%- e(appUrl('manage-menu')) %>">Quản lý món</a>
                <a class="nav-link <%= current === 'tables' ? 'is-active' : '' %>"
                    href="<%- e(appUrl('tables')) %>">Bàn ăn</a>
                <a class="nav-link <%= current === 'qr' ? 'is-active' : '' %>"
                    href="<%- e(appUrl('qr')) %>">Mã QR</a>
            <% } else if (role === 'staff') { %>
                <a class="nav-link <%= current === 'pos' ? 'is-active' : '' %>" href="<%- e(appUrl('pos')) %>">POS</a>
                <a class="nav-link <%= current === 'orders' ? 'is-active' : '' %>"
                    href="<%- e(appUrl('orders')) %>">Đơn hàng</a>
                <a class="nav-link <%= current === 'tables' ? 'is-active' : '' %>"
                    href="<%- e(appUrl('tables')) %>">Bàn ăn</a>
            <% } else if (role === 'kitchen') { %>
                <a class="nav-link <%= current === 'kitchen' ? 'is-active' : '' %>"
                    href="<%- e(appUrl('kitchen')) %>">Nhà bếp</a>
            <% } %>
            <div class="nav-actions">
                <button type="button" class="btn btn-ghost btn-icon" id="themeToggle" aria-label="Đổi giao diện sáng tối"
                    style="margin-right:0.5rem; padding: 0.5rem; border-radius: 50%;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                        id="themeIcon">
                        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                    </svg>
                </button>
                <% if (role !== 'guest') { %>
                    <div class="nav-user"
                        style="display: flex; align-items: center; gap: 0.5rem; text-align: left; margin-right: 0.5rem;">
                        <div
                            style="width: 32px; height: 32px; flex-shrink: 0; border: 2px solid #c9a962; border-radius: 50%; overflow: hidden; background: #faf8f4; color: #c9a962; display: flex; align-items: center; justify-content: center; font-weight: bold; text-transform: uppercase;">
                            <%- e(String(user?.email || 'U').slice(0, 1)) %>
                        </div>
                        <div style="display: flex; flex-direction: column; line-height: 1.2;">
                            <span
                                style="font-weight: 600; font-size: 0.9rem;"><%- e(role === 'admin' ? 'Quản trị viên' : (user?.full_name === 'System Administrator' ? 'Quản trị viên' : (user?.full_name ?? 'Người dùng'))) %></span>
                            <span
                                style="font-size: 0.75rem; color: var(--text-muted);"><%- e(user?.email ?? '') %></span>
                        </div>
                    </div>
                    <a class="btn btn-outline btn-sm" href="<%- e(appUrl('logout')) %>">Đăng xuất</a>
                <% } else { %>
                    <a class="btn btn-ghost btn-sm" href="<%- e(appUrl('login')) %>">Đăng nhập</a>
                    <a class="btn btn-primary btn-sm nav-link-register" href="<%- e(appUrl('menu')) %>">Đặt món</a>
                <% } %>
            </div>
        </nav>
    </div>
</header>
