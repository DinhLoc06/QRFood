<% if (!minimalLayout) { %>
<footer class="site-footer restaurant-footer">
    <div class="restaurant-footer__main">
        <div class="restaurant-footer__brand"><%- include('logo', { logoClass: 'vp-logo-on-mark' }) %><div><strong>Mì Cay Seoul</strong><span>Đậm vị Hàn · Cay đúng điệu</span></div></div>
        <p class="restaurant-footer__intro">Tô mì cay nóng hổi, món Hàn đậm vị và những cuộc hẹn vui hơn bên bàn ăn.</p>
        <div class="restaurant-footer__info"><div><span>Phục vụ</span><strong>Gọi món tại bàn qua mã QR</strong></div><div><span>Thực đơn</span><a href="<%- e(appUrl('menu')) %>">Khám phá các món Hàn</a></div><div><span>Vị cay</span><strong>7 cấp độ cho bạn lựa chọn</strong></div></div>
    </div>
    <div class="restaurant-footer__bottom"><span>© <%= new Date().getFullYear() %> Mì Cay Seoul</span><span>Nóng hổi · Đậm vị · Vui hết mình</span></div>
</footer></div>
<div id="toastHost" class="toast-host" aria-live="polite" aria-atomic="true"></div>
<script>window.SRMS=window.SRMS||{};window.SRMS.baseUrl=<%- jsonForScript(baseUrl) %>;window.SRMS.csrfToken=<%- jsonForScript(csrfToken) %>;window.SRMS.pollMs=5000;window.SRMS.gstRate=<%= gstRate %>;</script>
<script src="<%= assetUrl('js/srms-api.js') %>"></script><script src="<%= assetUrl('js/nav.js') %>"></script>
<% for (const src of extraScripts || []) { %><script src="<%= assetUrl('js/' + src) %>"></script><% } %>
<% } else { %><script>window.SRMS={baseUrl:<%- jsonForScript(baseUrl) %>,csrfToken:<%- jsonForScript(csrfToken) %>};</script><% } %>
</body></html>
