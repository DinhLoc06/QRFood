<%- include('../partials/head') %><% if (!minimalLayout) { %><div class="app-shell"><%- include('../partials/nav') %><% } %>
<main id="main-content">
    <header class="page-header">
        <div>
            <h1 class="page-title">Thực đơn và danh mục</h1>
            <p class="page-sub">Thêm món, tải ảnh và sắp xếp danh mục</p>
        </div>
    </header>

    <div class="layout-pos" style="grid-template-columns:1fr;">
        <section class="card">
            <div class="card-body">
                <h2 class="card-title">Danh mục</h2>
                <form id="catForm" class="no-print" style="display:flex;flex-wrap:wrap;gap:0.5rem;align-items:flex-end;margin-bottom:1rem;">
                    <input type="hidden" id="catId" value="">
                    <div class="form-group" style="flex:1;min-width:140px;margin:0;">
                        <label class="form-label" for="catName">Tên danh mục</label>
                        <input class="form-input" id="catName" maxlength="64" required>
                    </div>
                    <div class="form-group" style="width:100px;margin:0;">
                        <label class="form-label" for="catSort">Thứ tự</label>
                        <input class="form-input" id="catSort" type="number" value="0">
                    </div>
                    <button type="submit" class="btn btn-primary">Lưu danh mục</button>
                    <button type="button" class="btn btn-secondary" id="catReset">Xóa nội dung</button>
                </form>
                <div class="table-wrap table-cards-sm">
                    <table class="data-table" id="catTable">
                        <thead>
                            <tr>
                                <th>Tên</th>
                                <th>Thứ tự</th>
                                <th class="no-print">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody id="catBody"></tbody>
                    </table>
                </div>
            </div>
        </section>

        <section class="card card-spaced">
            <div class="card-body">
                <h2 class="card-title">Món ăn</h2>
                <p class="text-muted form-hint">Bạn có thể dán liên kết ảnh trực tiếp hoặc tải ảnh món ăn lên từ thiết bị.</p>
                <form id="itemForm" class="no-print" enctype="multipart/form-data">
                    <input type="hidden" id="itemId" value="">
                    <div class="form-group">
                        <label class="form-label" for="itemName">Tên món</label>
                        <input class="form-input" id="itemName" maxlength="128" required>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="itemDesc">Mô tả</label>
                        <textarea class="form-textarea" id="itemDesc" maxlength="2000"></textarea>
                    </div>
                    <div class="form-grid-2">
                        <div class="form-group mb-0">
                            <label class="form-label" for="itemPrice">Giá (VNĐ)</label>
                            <input class="form-input" id="itemPrice" type="number" step="0.01" min="0" required>
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label" for="itemCategory">Danh mục</label>
                            <select class="form-select" id="itemCategory" required></select>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="itemImageUrl">Liên kết ảnh (không bắt buộc)</label>
                        <input class="form-input" id="itemImageUrl" type="url" inputmode="url" placeholder="https://… (Unsplash, CDN, or your host)" autocomplete="off">
                        <p class="text-muted form-hint">Dán URL ảnh trực tiếp hoặc tải tệp lên bên dưới. Ảnh tải lên sẽ được ưu tiên.</p>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="itemImage">Tải ảnh lên</label>
                        <input class="form-input" id="itemImage" type="file" accept="image/jpeg,image/png,image/webp,image/gif">
                        <p class="text-muted form-hint">Không bắt buộc. Dung lượng tối đa 2MB.</p>
                    </div>
                    <div class="form-group">
                        <label class="form-label"><input type="checkbox" id="itemActive" checked> Hiển thị trên thực đơn</label>
                    </div>
                    <div class="btn-group">
                        <button type="submit" class="btn btn-primary">Lưu món</button>
                        <button type="button" class="btn btn-secondary" id="itemReset">Thêm món mới</button>
                    </div>
                </form>
                <div id="itemPreview" class="no-print item-preview-box"></div>
                <div class="table-wrap table-cards-sm table-below-form">
                    <table class="data-table" id="itemTable">
                        <thead>
                            <tr>
                                <th>Món ăn</th>
                                <th>Danh mục</th>
                                <th>Giá</th>
                                <th>Hiển thị</th>
                                <th class="no-print">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody id="itemBody"></tbody>
                    </table>
                </div>
            </div>
        </section>
    </div>
</main>

<script id="srms-menu-initial" type="application/json"><%- jsonForScript({ items: itemsPayload, categories: catsPayload }) %></script>
<%- include('../partials/footer') %>
