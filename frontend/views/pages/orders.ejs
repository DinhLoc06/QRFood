<%- include('../partials/head') %><% if (!minimalLayout) { %><div class="app-shell"><%- include('../partials/nav') %><% } %>
<main id="main-content" data-customer="<%= role === 'customer' ? '1' : '0' %>">
    <header class="page-header">
        <div>
            <h1 class="page-title">Đơn hàng</h1>
            <p class="page-sub"><%= role === 'customer' ? 'Các đơn hàng gần đây của bạn' : 'Theo dõi và cập nhật trạng thái đơn hàng' %></p>
        </div>
        <div class="btn-group">
            <button type="button" class="btn btn-secondary btn-sm" id="btnRefreshOrders">Làm mới</button>
            <% if (role !== 'customer') { %>
                <a class="btn btn-primary btn-sm" href="<%- e(appUrl('pos')) %>">Tạo đơn mới</a>
            <% } %>
        </div>
    </header>

    <p class="text-muted mb-1" id="ordersSyncNote" aria-live="polite"></p>

    <div class="table-wrap table-cards-sm">
        <table class="data-table" id="ordersTable">
            <thead>
                <tr>
                    <th>Mã đơn</th>
                    <th>Hình thức</th>
                    <th>Bàn / Khách hàng</th>
                    <th>Trạng thái</th>
                    <th>Tổng tiền</th>
                    <th>Thời gian</th>
                    <th class="no-print">Thao tác</th>
                </tr>
            </thead>
            <tbody id="ordersBody">
                <% for (const o of orders || []) { %>
                    <tr data-order-id="<%= o.id %>">
                        <td data-label="Code"><strong><%- e(o.order_code) %></strong></td>
                        <td data-label="Hình thức"><%- e((o.type ?? '') === 'DINE_IN' ? 'Dùng tại quán' : 'Đơn cũ') %></td>
                        <td data-label="Details">
                            <% if ((o.type ?? '') === 'DINE_IN') { %>
                                <%- e((o.table_label ?? '—')) %>
                            <% } else { %>
                                <%- e((o.customer_name ?? '')) %><br>
                                <span class="text-muted"><%- e((o.customer_phone ?? '')) %></span>
                            <% } %>
                        </td>
                        <td data-label="Trạng thái"><span class="badge <%- e('badge-' + o.status.replace(/[^a-z]/g, '')) %>"><%- e(({ pending: 'Chờ xác nhận', preparing: 'Đang chế biến', ready: 'Sẵn sàng', completed: 'Hoàn tất' })[o.status] || o.status) %></span></td>
                        <td data-label="Tổng tiền"><%= Math.round(Number(o.total)).toLocaleString('vi-VN') %> ₫</td>
                        <td data-label="Thời gian" class="text-muted"><%- e(o.created_at) %></td>
                        <td data-label="Thao tác" class="no-print">
                            <div class="btn-group">
                                <a class="btn btn-outline btn-sm" href="<%- e(appUrl('invoice/' + o.id)) %>">Hóa đơn</a>
                                <% if (role !== 'customer') { %>
                                <select class="form-select status-select btn-sm" style="min-width:120px;padding:0.35rem;" data-order-id="<%= o.id %>" aria-label="Cập nhật trạng thái cho <%- e(o.order_code) %>">
                                    <% for (const st of ["pending", "preparing", "ready", "completed"]) { %>
                                        <option value="<%= st %>" <%= (o.status ?? '') === st ? 'selected' : '' %>><%= st === 'completed' ? 'Hoàn tất' : ({ pending: 'Chờ xác nhận', preparing: 'Đang chế biến', ready: 'Sẵn sàng' }[st] || st) %></option>
                                    <% } %>
                                </select>
                                <% } %>
                            </div>
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</main>
<%- include('../partials/footer') %>
