<%- include('../partials/head') %><% if (!minimalLayout) { %><div class="app-shell"><%- include('../partials/nav') %><% } %>
<main id="main-content">
    <header class="page-header">
        <div>
            <h1 class="page-title">Tổng quan</h1>
            <p class="page-sub">Theo dõi hoạt động và hiệu quả kinh doanh theo thời gian thực</p>
        </div>
        <button type="button" class="btn btn-secondary btn-sm" id="refreshDashboard">Làm mới</button>
    </header>

    <div class="grid-stats grid-stats--auto" id="statGrid">
        <article class="stat-card">
            <p class="stat-label">Tổng đơn hàng</p>
            <p class="stat-value" id="statTotalOrders"><%= stats.total_orders %></p>
        </article>
        <article class="stat-card">
            <p class="stat-label">Doanh thu đã hoàn tất</p>
            <p class="stat-value" id="statRevenue"><%= Math.round(Number(stats.revenue)).toLocaleString('vi-VN') %> ₫</p>
        </article>
        <article class="stat-card">
            <p class="stat-label">Đơn hàng hôm nay</p>
            <p class="stat-value" id="statOrdersToday"><%= stats.orders_today %></p>
        </article>
        <article class="stat-card">
            <p class="stat-label">Doanh thu hôm nay</p>
            <p class="stat-value" id="statRevenueToday"><%= Math.round(Number(stats.revenue_today)).toLocaleString('vi-VN') %> ₫</p>
        </article>
        <article class="stat-card">
            <p class="stat-label">Bàn đang sử dụng</p>
            <p class="stat-value" id="statOccupied"><%= stats.tables_occupied %></p>
        </article>
        <article class="stat-card">
            <p class="stat-label">Bàn còn trống</p>
            <p class="stat-value" id="statAvailable"><%= stats.tables_available %></p>
        </article>
    </div>

    <div class="layout-pos layout-pos--dashboard">
        <div class="dashboard-charts-stack">
            <% if (true) { %>
            <section class="card">
                <div class="card-body">
                    <h2 class="card-title">Doanh thu 7 ngày gần nhất</h2>
                    <div class="chart-wrap">
                        <canvas id="revenueChart" aria-label="Biểu đồ doanh thu"></canvas>
                    </div>
                </div>
            </section>
            <% } %>
            <section class="card">
                <div class="card-body">
                    <h2 class="card-title">Đơn hàng theo trạng thái</h2>
                    <div class="chart-wrap chart-wrap--narrow">
                        <canvas id="statusChart" aria-label="Biểu đồ trạng thái đơn hàng"></canvas>
                    </div>
                </div>
            </section>
        </div>
        <section class="card">
            <div class="card-body">
                <h2 class="card-title">Món được yêu thích</h2>
                <div id="popularList">
                    <% if (!popular?.length) { %>
                        <p class="text-muted mt-0">Chưa có đơn hàng hoàn tất.</p>
                    <% } else { %>
                        <ul class="kitchen-items">
                            <% for (const p of popular || []) { %>
                                <li><strong><%- e(p.name) %></strong> — đã bán <%= p.total_qty %></li>
                            <% } %>
                        </ul>
                    <% } %>
                </div>
            </div>
        </section>
    </div>
</main>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js" crossorigin="anonymous"></script>
<script id="srms-dashboard-json" type="application/json"><%- jsonForScript(dashPayload) %></script>
<%- include('../partials/footer') %>
