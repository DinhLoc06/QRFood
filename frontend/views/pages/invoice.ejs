<%- include('../partials/head') %><% if (!minimalLayout) { %><div class="app-shell"><%- include('../partials/nav') %><% } %>
<main id="main-content" class="invoice-print">
    <header class="page-header">
        <div>
            <h1 class="page-title">Hóa đơn</h1>
            <p class="page-sub"><%- e((order.order_code ?? '')) %> · <%- e((order.type ?? '')) %></p>
        </div>
        <div class="btn-group no-print">
            <button type="button" class="btn btn-primary btn-sm" onclick="window.print()">In hóa đơn</button>
            <a class="btn btn-outline btn-sm" href="<%- e(appUrl('orders')) %>">Quay lại đơn hàng</a>
        </div>
    </header>

    <section class="card" style="max-width:720px;margin:0 auto;">
        <div class="card-body">
            <div style="display:flex;flex-wrap:wrap;justify-content:space-between;gap:1rem;margin-bottom:1.25rem;">
                <div>
                    <p class="mt-0" style="font-weight:700;margin:0 0 0.25rem;">Velvet Plate</p>
                    <p class="text-muted mt-0" style="font-size:0.9rem;">Hóa đơn đã bao gồm thuế</p>
                </div>
                <div style="text-align:right;">
                    <p class="mt-0"><strong>Ngày:</strong> <%- e(order.created_at) %></p>
                    <p class="mt-0"><strong>Trạng thái:</strong> <%- e(order.status) %><%= (order.status ?? '') === 'completed' ? ' (' + e(doneLabel) + ')' : '' %></p>
                </div>
            </div>

            <% if ((order.type ?? '') === 'DINE_IN') { %>
                <p><strong>Bàn:</strong> <%- e((order.table_label ?? '—')) %></p>
            <% } else { %>
                <p><strong>Khách hàng:</strong> <%- e((order.customer_name ?? '')) %></p>
                <p><strong>Điện thoại:</strong> <%- e((order.customer_phone ?? '')) %></p>
                <p><strong>Địa chỉ:</strong><br><%= nl2br(e((order.delivery_address ?? ''))) %></p>
            <% } %>

            <div class="table-wrap" style="margin-top:1rem;">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Món ăn</th>
                            <th>Số lượng</th>
                            <th>Đơn giá</th>
                            <th>Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% for (const li of items || []) { %>
                            <tr>
                                <td><%- e((li.item_name ?? '')) %></td>
                                <td><%= li.quantity %></td>
                                <td><%= Math.round(Number(li.unit_price)).toLocaleString('vi-VN') %> ₫</td>
                                <td><%= Math.round(Number(li.line_total)).toLocaleString('vi-VN') %> ₫</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <div style="margin-top:1rem;max-width:280px;margin-left:auto;font-size:0.95rem;">
                <div class="cart-summary-row"><span>Tạm tính</span><span><%= Math.round(Number(order.subtotal)).toLocaleString('vi-VN') %> ₫</span></div>
                <div class="cart-summary-row">
                    <span>Thuế (<%- e(order.gst_rate) %>%)</span>
                    <span><%= Math.round(Number(order.gst_amount)).toLocaleString('vi-VN') %> ₫</span>
                </div>
                <div class="cart-summary-row cart-summary-total" style="margin-top:0.5rem;padding-top:0.5rem;border-top:2px solid var(--border);">
                    <span>Tổng cộng</span>
                    <span><%= Math.round(Number(order.total)).toLocaleString('vi-VN') %> ₫</span>
                </div>
            </div>
        </div>
    </section>
</main>
<%- include('../partials/footer') %>
