<%- include('../partials/head') %><% if (!minimalLayout) { %><div class="app-shell"><%- include('../partials/nav') %><% } %>
<main id="main-content" class="menu-page-wrap">
    <header class="page-menu-hero">
        <p class="eyebrow">Chọn món thật dễ</p>
        <h1 class="page-menu-title">Thực đơn hôm nay</h1>
        <p class="page-menu-sub">Tìm món yêu thích, chọn số lượng và đặt món chỉ trong vài bước.</p>
    </header>

    <div class="menu-toolbar">
        <div class="search-input">
            <label class="sr-only" for="menuSearch">Tìm món ăn</label>
            <input type="text" id="menuSearch" class="form-input" placeholder="Tìm món ăn, nguyên liệu..."
                autocomplete="off">
        </div>
        <div class="filter-chips" id="categoryChips" role="tablist" aria-label="Danh mục món ăn"></div>
    </div>

    <div class="layout-pos">
        <div class="menu-grid" id="menuGrid"></div>

        <aside class="cart-panel cart-panel--lux" aria-label="Đơn món của bạn">
            <h2 class="cart-title-lux text-center"
                style="font-family: var(--font-display); font-size: 1.6rem; letter-spacing: 1px; color: var(--accent);">
                Giỏ món của bạn</h2>
            <div class="form-group" style="padding: 1rem 1.25rem 0.5rem;">
                <label class="form-label" for="orderType">Hình thức nhận món</label>
                <select class="form-select" id="orderType">
                    <option value="DINE_IN">Dùng tại quán</option>
                    <option value="DELIVERY">Giao tận nơi</option>
                </select>
            </div>

            <div id="cartEmpty" class="cart-empty-state">
                <img src="<%- e(appUrl('frontend/assets/empty-tray.png')) %>" alt="Giỏ món đang trống"
                    class="cart-empty-image">
                <p>Giỏ món đang trống.<br>Hãy chọn một món ngon từ thực đơn nhé!</p>
            </div>

            <div id="cartSummary" class="cart-summary-inner-wrap is-hidden">
                <div class="cart-lines-container">
                    <div class="cart-lines" id="cartLines"></div>
                </div>

                <div class="cart-summary-sticky">
                    <div class="cart-summary-card">
                        <div class="cart-summary-row">
                            <span>Tạm tính</span><span id="sumSub">0 ₫</span>
                        </div>
                        <div class="cart-summary-row">
                            <span>Thuế (<span id="gstPctLabel">18</span>%)</span><span id="sumGst">0 ₫</span>
                        </div>
                        <div class="cart-summary-row" id="rowDeliveryFee" hidden>
                            <span>Phí giao hàng</span><span id="sumDelivery">0 ₫</span>
                        </div>
                        <div class="cart-summary-total">
                            <span>Tổng cộng</span><span id="sumTotal">0 ₫</span>
                        </div>
                    </div>

                    <div id="wrapTable" class="table-booking-compact">
                        <label class="form-label" for="selectedTable">Chọn bàn</label>
                        <select class="form-select" id="selectedTable">
                            <option value="0">Chọn bàn còn trống</option>
                            <% for (const t of tables || []) { %>
                                <% if (t.status === 'available') { %>
                                    <option value="<%= t.id %>"><%- e(t.label) %> (<%= t.capacity %> chỗ)</option>
                                <% } %>
                            <% } %>
                        </select>
                    </div>
                    <button type="button" id="btnPlace" class="btn btn-primary btn-block btn-lg btn-place-order">
                        Tiến hành đặt món
                    </button>
                </div>
            </div>
        </aside>
    </div>
</main>
<script type="application/json" id="srms-pos-initial"><%- jsonForScript({ menu, gstRate }) %></script>

<!-- Checkout Multi-step Modal -->
<div class="modal" id="checkoutModal">
    <div class="modal-backdrop"></div>
    <div class="modal-content">
        <div class="modal-header">
            <h3 class="modal-title" id="checkoutModalTitle">Hoàn tất đơn hàng</h3>
            <button class="modal-close" id="closeCheckoutModal">&times;</button>
        </div>
        <div class="modal-body">
            <!-- Step 1: Address (Only for Delivery) -->
            <div id="stepAddress" class="checkout-step">
                <h4 class="mb-1">Thông tin khách hàng</h4>
                <div class="form-group">
                    <label class="form-label">Họ và tên</label>
                    <input type="text" class="form-input" id="checkoutName" placeholder="Nhập họ và tên">
                </div>
                <div class="form-group">
                    <label class="form-label">Số điện thoại</label>
                    <input type="tel" class="form-input" id="checkoutPhone" placeholder="Nhập số điện thoại">
                </div>
                <div id="wrapCheckoutAddr">
                    <div class="form-group">
                        <label class="form-label">Địa chỉ giao hàng</label>
                        <textarea class="form-textarea" id="checkoutAddr" placeholder="Nhập địa chỉ đầy đủ..."></textarea>
                    </div>
                </div>
                <button class="btn btn-primary btn-block" id="btnNextToPayment">Tiếp tục thanh toán</button>
            </div>

            <!-- Step 2: Payment -->
            <div id="stepPayment" class="checkout-step" style="display:none">
                <h4 class="mb-1">Chọn phương thức thanh toán</h4>
                <div class="payment-options">
                    <label class="payment-option">
                        <input type="radio" name="paymentMethod" value="COD" checked>
                        <div class="payment-option-card">
                            <span class="payment-option-icon">💵</span>
                            <span>Thanh toán khi nhận món</span>
                        </div>
                    </label>
                    <label class="payment-option">
                        <input type="radio" name="paymentMethod" value="UPI">
                        <div class="payment-option-card">
                            <span class="payment-option-icon">📱</span>
                            <span>Chuyển khoản bằng mã QR</span>
                        </div>
                    </label>
                </div>
                <button class="btn btn-primary btn-block mt-3" id="btnNextToConfirm">Kiểm tra đơn hàng</button>
            </div>

            <!-- Step 3: Confirmation -->
            <div id="stepConfirm" class="checkout-step" style="display:none">
                <h4 class="mb-1">Tóm tắt đơn hàng</h4>
                <div class="confirm-details card p-3 mb-3" style="background:var(--bg-elevated)">
                    <p id="confirmSummaryName"></p>
                    <p id="confirmSummaryPhone"></p>
                    <p id="confirmSummaryAddr" class="mb-0"></p>
                </div>

                <!-- UPI QR Section -->
                <div id="upiQrSection" style="display:none; text-align:center; margin-bottom:1.5rem;">
                    <p class="text-muted mb-2">Quét mã QR để thanh toán <span id="upiAmount">0</span> ₫</p>
                    <div id="upiQrPlaceholder"
                        style="width:180px; height:180px; background:#fff; margin:0 auto; padding:10px; border-radius:10px; border:1px solid #ddd">
                        <img src="https://api.qrserver.com/v1/create-qr-code/?size=160x160&data=upi://pay?pa=velvetplate@upi"
                            alt="QR Code" style="width:160px; height:160px">
                    </div>
                </div>

                <button class="btn btn-primary btn-block" id="btnFinalConfirm">Xác nhận đặt món</button>
            </div>

            <!-- Step 4: Success -->
            <div id="stepSuccess" class="checkout-step" style="display:none; text-align:center; padding:2rem 0">
                <div style="font-size:4rem; margin-bottom:1rem">✅</div>
                <h3 class="font-display">Đặt món thành công!</h3>
                <p class="text-muted">Bếp đang chuẩn bị món ăn của bạn.</p>
                <div class="card p-3 mt-3 mb-3" style="background:var(--bg-elevated)">
                    <p class="mb-1">Mã đơn: <strong id="successOrderId">#--</strong></p>
                    <p class="mb-0">Thanh toán: <strong id="successPayment">--</strong></p>
                </div>
                <button class="btn btn-outline btn-block" onclick="window.location.reload()">Hoàn tất</button>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
