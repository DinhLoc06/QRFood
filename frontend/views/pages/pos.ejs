<%- include('../partials/head') %><% if (!minimalLayout) { %><div class="app-shell"><%- include('../partials/nav') %><% } %>
<main id="main-content">
    <header class="page-header">
        <div>
            <h1 class="page-title">Tạo đơn mới</h1>
            <p class="page-sub">Tìm món, thêm vào giỏ và tạo đơn tại quán</p>
        </div>
        <div class="btn-group no-print">
            <a class="btn btn-outline btn-sm" href="<%- e(appUrl('orders')) %>">Tất cả đơn hàng</a>
        </div>
    </header>

    <div class="layout-pos">
        <div>
            <div class="menu-toolbar">
                <input type="search" class="form-input search-input" id="menuSearch" placeholder="Tìm trong thực đơn..." autocomplete="off" aria-label="Tìm trong thực đơn">
                <div class="filter-chips" id="categoryChips" role="tablist" aria-label="Danh mục"></div>
            </div>
            <div class="loading-overlay" id="menuLoading" aria-hidden="true">
                <div class="spinner" aria-hidden="true"></div>
            </div>
            <div class="menu-grid" id="menuGrid"></div>
        </div>

        <aside class="cart-panel" aria-label="Giỏ món">
            <h2 class="card-title mt-0 text-center" style="font-family: var(--font-display); font-size: 1.5rem; letter-spacing: 1px;">Món đã chọn</h2>
            <div class="form-group" id="wrapTable">
                <label class="form-label" for="tableId">Bàn <span class="text-muted" style="font-size:0.8em;">(bắt buộc)</span></label>
                <select class="form-select" id="tableId" aria-label="Bàn ăn">
                    <option value="0">— Chọn bàn —</option>
                    <% for (const t of tables || []) { %>
                        <option value="<%= t.id %>" data-status="<%- e(t.status) %>">
                            <%- e(t.label) %> (<%= t.capacity %> chỗ)
                        </option>
                    <% } %>
                </select>
            </div>

            <div class="cart-lines" id="cartLines">
                <div id="cartEmpty" class="cart-empty-state">
                    <img src="<%- e(appUrl('frontend/assets/empty-tray.png')) %>" alt="Giỏ món đang trống" class="cart-empty-image">
                    <p>Giỏ món đang trống.<br>Hãy chọn món từ thực đơn!</p>
                </div>
            </div>
            <div class="cart-summary-sticky is-hidden" id="cartSummary">
                <div class="cart-summary-inner">
                    <div class="cart-summary-row"><span>Tạm tính</span><span id="sumSub">0 ₫</span></div>
                    <div class="cart-summary-row"><span>Thuế (<%- e(gstRate) %>%)</span><span id="sumGst">0 ₫</span></div>
                    <div class="cart-summary-total"><span>Tổng cộng</span><span id="sumTotal">0 ₫</span></div>
                </div>
                <button type="button" class="btn btn-primary btn-block btn-lg" id="btnPlace" style="margin-top:0.75rem;">Tiến hành đặt món</button>
            </div>
        </aside>
    </div>
</main>

<!-- Checkout Multi-step Modal -->
<div class="modal" id="checkoutModal">
    <div class="modal-backdrop"></div>
    <div class="modal-content">
        <div class="modal-header">
            <h3 class="modal-title" id="checkoutModalTitle">Thanh toán</h3>
            <button class="modal-close" id="closeCheckoutModal">&times;</button>
        </div>
        <div class="modal-body">
            <!-- Step 1: Customer details -->
            <div id="stepAddress" class="checkout-step">
                <h4 class="mb-1" id="checkoutStepTitle">Thông tin khách hàng</h4>
                <div class="form-group">
                    <label class="form-label">Họ và tên</label>
                    <input type="text" class="form-input" id="checkoutName" placeholder="Nhập họ và tên">
                </div>
                <div class="form-group">
                    <label class="form-label">Số điện thoại</label>
                    <input type="tel" class="form-input" id="checkoutPhone" placeholder="Nhập số điện thoại">
                </div>
                <button class="btn btn-primary btn-block" id="btnNextToPayment">Tiếp tục thanh toán</button>
            </div>

            <!-- Step 2: Payment -->
            <div id="stepPayment" class="checkout-step" style="display:none">
                <h4 class="mb-1">Thanh toán tại quầy</h4>
                <p class="text-muted">Bạn thanh toán với nhân viên sau khi món ăn được phục vụ.</p>
                <button class="btn btn-primary btn-block mt-3" id="btnNextToConfirm">Kiểm tra đơn hàng</button>
            </div>

            <!-- Step 3: Confirmation -->
            <div id="stepConfirm" class="checkout-step" style="display:none">
                <h4 class="mb-1">Tóm tắt đơn hàng</h4>
                <div class="confirm-details card p-3 mb-3" style="background:var(--bg-elevated)">
                    <p id="confirmSummaryName"></p>
                    <p id="confirmSummaryPhone"></p>
                    <p id="confirmSummaryAddr" class="mb-0"></p>
                </div>
                <button class="btn btn-primary btn-block" id="btnFinalConfirm">Xác nhận đặt món</button>
            </div>

            <!-- Step 4: Success -->
            <div id="stepSuccess" class="checkout-step" style="display:none; text-align:center; padding:2rem 0">
                <div style="font-size:4rem; margin-bottom:1rem">✅</div>
                <h3 class="font-display">Đặt món thành công!</h3>
                <p class="text-muted">Bếp đang chuẩn bị món ăn của bạn.</p>
                <div class="card p-3 mt-3 mb-3" style="background:var(--bg-elevated)">
                    <p class="mb-1">Mã đơn: <strong id="successOrderId">#--</strong></p>
                    <p class="mb-0">Thanh toán: <strong id="successPayment">--</strong></p>
                </div>
                <button class="btn btn-outline btn-block" onclick="window.location.reload()">Hoàn tất</button>
            </div>
        </div>
    </div>
</div>

<script id="srms-pos-initial" type="application/json"><%- jsonForScript({ menu: menuInitial, gstRate }) %></script>
<%- include('../partials/footer') %>
