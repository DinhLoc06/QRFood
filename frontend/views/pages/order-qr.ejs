<%- include('../partials/head') %>
<div class="app-shell">
    <%- include('../partials/nav') %>
    <main id="main-content">
        <header class="page-header">
            <div>
                <h1 class="page-title">Mã QR gọi món</h1>
                <p class="page-sub">In mã QR dùng chung để khách xem thực đơn và gọi món mà không cần đăng nhập.</p>
            </div>
            <button class="btn btn-primary btn-sm no-print" type="button" onclick="window.print()">In mã QR</button>
        </header>

        <section class="card" style="max-width:640px;margin:0 auto;">
            <div class="card-body" style="text-align:center;">
                <img src="<%- e(qrImage) %>" alt="Mã QR mở thực đơn gọi món Mì Cay Seoul"
                    style="width:min(320px,80vw);height:auto;background:#fff;padding:1rem;border-radius:0.75rem;">
                <p><strong>Quét mã để xem thực đơn và gọi món</strong></p>
                <p class="text-muted">Khách chọn bàn, chọn món và gửi đơn dùng tại quán. Không cần tài khoản.</p>
                <p><a href="<%- e(orderUrl) %>"><%- e(orderUrl) %></a></p>
                <p class="text-muted no-print">Khi phát triển cục bộ, điện thoại cần dùng chung Wi-Fi với máy tính. Nếu không kết nối được, hãy cho phép Node.js qua Windows Firewall. Để truy cập công khai, hãy triển khai ứng dụng trên tên miền HTTPS và đặt <code>QR_PUBLIC_URL</code> trong <code>.env</code>.</p>
            </div>
        </section>
    </main>
</div>
<%- include('../partials/footer') %>
